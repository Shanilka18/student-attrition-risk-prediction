# Multi-Stage Dockerfile for React + Vite Counselor Dashboard
# SLIIT CDAP Project KND-CDAP-IT-05 (Environmental Risk Intelligence)

# Build Stage
FROM node:22-alpine as builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Production Serving Stage
FROM nginx:alpine as runner

# Custom Nginx configuration supporting Vite SPA routing and backend proxy
RUN echo 'server {' \
    '    listen 80;' \
    '    server_name localhost;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '    location /api/ {' \
    '        proxy_pass http://backend:8000/;' \
    '        proxy_set_header Host $host;' \
    '        proxy_set_header X-Real-IP $remote_addr;' \
    '    }' \
    '    location /dag/image {' \
    '        proxy_pass http://backend:8000/dag/image;' \
    '    }' \
    '    location /download/ {' \
    '        proxy_pass http://backend:8000/download/;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
