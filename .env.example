# Environmental & Financial Causal Risk Intelligence Framework (ERI)
# Environment Configuration Template
# Copy this file to .env before starting services

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
DATA_TYPE=SYNTHETIC
RANDOM_SEED=42

# Security, Privacy & Traffic Controls
MAX_UPLOAD_MB=50
RATE_LIMIT_PER_MINUTE=200
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend Dashboard Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8000

# Group Fusion Framework Contract
FUSION_API_KEY=optional_shared_secret_for_group_interop
FUSION_TIMEOUT_SECONDS=10
