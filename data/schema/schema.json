{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudentAcademicObservationSchema",
  "description": "Standard schema for student-semester academic observations in long format",
  "type": "object",
  "required": [
    "student_id",
    "semester",
    "gpa",
    "exam_marks",
    "attendance_pct",
    "assignment_delay_days",
    "late_assignments_count"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Anonymized unique student identifier"
    },
    "semester": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Chronological semester index (1 = Year 1 Sem 1, up to 8 = Year 4 Sem 2)"
    },
    "gpa": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 4.0,
      "description": "Semester Grade Point Average on 0.0 - 4.0 scale"
    },
    "exam_marks": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Semester average exam marks percentage (0 - 100%)"
    },
    "attendance_pct": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Lecture and tutorial attendance rate (0 - 100%)"
    },
    "assignment_delay_days": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 45.0,
      "description": "Average delay across assignments in days"
    },
    "late_assignments_count": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 15,
      "description": "Count of assignments submitted past deadline"
    }
  }
}
